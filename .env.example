DATABASE_URI=
JWT_SECRET=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SERVICE=
APP_BASE_URL=

PORT=
JWT_EXPIRES_IN=

# Airwallex
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=
AIRWALLEX_ENV=
AIRWALLEX_DESCRIPTOR_PREFIX=
AIRWALLEX_WEBHOOK_SECRET=

CARD_ENCRYPTION_KEY=

AIRWALLEX_MODE=sandbox
AIRWALLEX_SANDBOX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_SANDBOX_CLIENT_ID=
AIRWALLEX_SANDBOX_API_KEY=
AIRWALLEX_LIVE_BASE_URL=https://api.airwallex.com
AIRWALLEX_LIVE_CLIENT_ID=
AIRWALLEX_LIVE_API_KEY=

# Session lifetimes (optional). The browser session is kept in HttpOnly cookies.
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d

# VNP Access Portal (contract v2)
# The portal's BACKEND address — handoff codes are redeemed at
# {ACCESS_PORTAL_URL}/api/handoff/redeem. Not the portal's public site:
# https://portal.dashboardvnps.com is a static frontend and answers that path
# with 405. Get the API host from the portal team.
ACCESS_PORTAL_URL=
# 32+ chars, unique to this system. Sent to the portal when redeeming a handoff code.
ACCESS_PORTAL_HANDOFF_SECRET=replace-with-32-plus-random-characters
# 32+ chars, unique to this system, DIFFERENT from the handoff secret. Buys the
# portal a service token here — as powerful as a full administrator.
JWT_COMMUNICATION_SECRET=replace-with-a-different-32-plus-random-characters
# Where the portal's tab lands. Defaults to APP_BASE_URL — set only if the
# frontend is served from somewhere else.
FRONTEND_URL=
# Extra origins allowed to complete a sign-in, comma-separated. This system's own
# origin (APP_BASE_URL / FRONTEND_URL) is always allowed.
CORS_ORIGINS=
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
